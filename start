#!/bin/bash
set -e

cd "$(dirname "$0")"

# 启动前清理端口残留，防止旧进程堆积
fuser -k 8000/tcp 2>/dev/null || true
sleep 1

echo "===================================="
echo "  查词词典 - 正在启动..."
echo "===================================="
echo ""

if [ ! -d "venv" ]; then
    echo "[ERROR] 虚拟环境不存在，请先运行: python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
    exit 1
fi

source venv/bin/activate

# 服务器无桌面环境，禁止自动打开浏览器
export OPEN_BROWSER=0

# 强制 Python 无缓冲输出，否则 print() 日志重定向到文件后需攒满 8KB 才落盘
export PYTHONUNBUFFERED=1

mkdir -p logs

PID_FILE=".server.pid"

# 检查是否已在运行
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE")
    if kill -0 "$OLD_PID" 2>/dev/null; then
        echo "[WARN] 服务已在运行（PID: $OLD_PID），如需重启请先执行: ./stop"
        exit 1
    else
        rm -f "$PID_FILE"
    fi
fi

echo "启动服务器（后台运行，按 Ctrl+C 不会停止）..."
echo ""

nohup python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 > logs/server.log 2>&1 &
SERVER_PID=$!

sleep 2
if kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "$SERVER_PID" > "$PID_FILE"
    echo "✅ 服务已启动，PID: $SERVER_PID"
    echo "   日志: logs/server.log"
    echo "   访问: http://localhost:8000"
    echo ""
    echo "   停止: ./stop"
    echo "   查看日志: tail -f logs/server.log"
else
    echo "[ERROR] 服务启动失败（进程已退出），查看: tail -f logs/server.log"
    exit 1
fi
