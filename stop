#!/bin/bash

# 注意：这里不要加 set -e，因为检测进程状态（kill -0 / lsof）返回非0是正常现象
cd "$(dirname "$0")"

PID_FILE=".server.pid"
PORT=8002

echo "正在停止服务..."

# 1. 如果存在 PID 文件，先尝试优雅停止主进程及其子进程
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
        echo "发送停止信号给主进程 (PID: $PID)..."
        # 使用 kill -- -$PID (向整个进程组发送 SIGTERM，能连同 Worker 一起打招呼)
        kill -- -"$PID" 2>/dev/null || kill "$PID" 2>/dev/null
        sleep 2
    else
        echo "⚠️ 进程 $PID 已不存在"
    fi
    rm -f "$PID_FILE"
fi

# 2. 强力清场：用端口精确杀残留进程，不会误伤其他 uvicorn 程序
fuser -k "$PORT/tcp" 2>/dev/null || true
sleep 1

# 3. 清理 Python 字节码缓存，确保下次启动读取全新代码
echo "正在清理 Python 字节码缓存 (__pycache__)..."
find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null

echo "✅ 服务已彻底停止，缓存已清理！"